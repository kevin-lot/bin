#!/usr/bin/env bash
# install or update my machines: professional macbook (darwin), personal computer (fedora)

#set -o xtrace -o errexit
set -o errexit

ZSH_PLUGINS_PATH="${HOME}/.zsh_plugins"
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
if [[ "${OS}" == "linux" ]]; then
    # distro id, e.g. "fedora"
    OS=$(. /etc/os-release && echo "${ID}")
fi
# filled by _setup_mise_tools, reported at the end: a failing tool must not stop the next steps
MISE_FAILED_TOOLS=()

_draw_spacer() { echo "+++++++++ +++++++++ +++++++++ +++++++++"; echo; echo; }
_draw_title() { echo "+++++++++ ${1} +++++++++"; echo; echo; }
_setup_docker_cli() {
    # docker only looks in ~/.docker/cli-plugins: point it to the brew compose/buildx plugins

    local docker_path="${HOME}/.docker"
    local docker_config_path="${docker_path}/config.json"

    _draw_title "docker cli setup"

    [[ -d "${docker_path}" ]] || install -d -m 700 "${docker_path}"
    [[ -s "${docker_config_path}" ]] || echo '{}' > "${docker_config_path}"
    # plutil (built into macos) edits the json in place, keeping other keys (auths, credsStore...)
    plutil -replace cliPluginsExtraDirs -json "[\"$(brew --prefix)/lib/docker/cli-plugins\"]" "${docker_config_path}"
}
_setup_colima() {
    # run the docker engine in a colima VM, started at login by brew services

    _draw_title "colima setup"

    # first run only: create the VM (vz + rosetta for amd64 images, sized for localstack + test containers; builds run on macos),
    # then stop it so brew services owns it
    if ! colima list --json 2>/dev/null | grep -q '"default"'; then
        colima start --vm-type vz --vz-rosetta --cpu 4 --memory 4 --disk 100
        colima stop
    fi
    # start now and at login
    brew services start colima
}
_install_zsh_plugins() {
    # clone missing zsh plugins, update existing ones (sourced by ~/.dotfiles zshrc.main)

    local zsh_plugins=(
        https://github.com/zsh-users/zsh-autosuggestions.git
        https://github.com/zsh-users/zsh-syntax-highlighting.git
        https://github.com/zsh-users/zsh-history-substring-search.git
    )
    local url install_path

    _draw_title "zsh plugins install"
    type -p git 1>/dev/null || { echo "git is required"; exit 1; }

    [[ -d "${ZSH_PLUGINS_PATH}" ]] || install -d -m 700 "${ZSH_PLUGINS_PATH}"

    for url in "${zsh_plugins[@]}"; do
        install_path="${ZSH_PLUGINS_PATH}/$(basename "${url}" .git)"
        if [[ -d "${install_path}/.git" ]]; then
            git -C "${install_path}" pull --quiet --ff-only
            continue
        fi
        rm -rf "${install_path}"
        git clone --quiet "${url}" "${install_path}"
    done
}
_setup_mise_tools() {
    # install or update global mise tools to latest, failing ones go to MISE_FAILED_TOOLS

    local mise_tools=(
        act
        actionlint
        aws-cli
        bat
        circleci
        claude
        dagger
        flutter
        gh
        jmespath
        jq
        lazygit
        mole
        node
        poetry
        rust
        terraform
        terraform-docs
        terragrunt
        tflint
        uv
        yamllint
        yq
    )
    local tool

    _draw_title "mise tools setup"
    type -p mise 1>/dev/null || { echo "mise is required"; exit 1; }

    # one call per tool: a failing tool must not block the others
    for tool in "${mise_tools[@]}"; do
        mise use --global "${tool}@latest" || MISE_FAILED_TOOLS+=("${tool}")
    done
}
_setup_rust() {
    # rust extras on top of mise rust: rust-analyzer for IDEs, cargo tools (cargo install also updates them)

    local cargo_tools=(
        cargo-cache
        cargo-lambda
        cargo-watch
    )

    _draw_title "rust setup"
    # mise exec: mise is not activated in this script, rust failing is already in MISE_FAILED_TOOLS
    mise which cargo &>/dev/null || { echo "rust is missing: skipped"; return 0; }

    mise exec -- rustup component add rust-analyzer
    mise exec -- cargo install --locked "${cargo_tools[@]}"
}

# shared by fedora and darwin
COMMON_PACKAGES=(
    btop
    git
    git-delta
    micro
    mise
    ncdu
    nmap
    starship
    xmlstarlet
)

if [[ "${OS}" == "fedora" ]]; then
    _draw_title "dnf packages setup"
    sudo dnf copr --assumeyes enable jdxcode/mise
    sudo dnf copr --assumeyes enable atim/starship
    sudo dnf update --assumeyes

    FEDORA_PACKAGES=(
        automake
        dconf-editor
        gcc
        gcc-c++
        gparted
        kernel-devel
        make
        rpi-imager
        terminator
        traceroute
        #ngrok
    )
    sudo dnf install --assumeyes "${FEDORA_PACKAGES[@]}" "${COMMON_PACKAGES[@]}"
fi

if [[ "${OS}" == "darwin" ]]; then
    _draw_title "brew packages setup"
    type -p brew 1>/dev/null || { echo "brew is required"; exit 1; }
    brew update && brew upgrade

    CASK_PACKAGES=(
        ghostty
        wizcli
    )
    brew install --cask "${CASK_PACKAGES[@]}"
    # docker engine runs in the colima VM, docker is only the CLI
    DOCKER_PACKAGES=(
        colima
        docker
        docker-buildx
        docker-compose
        docker-credential-helper
    )
    brew install "${COMMON_PACKAGES[@]}" "${DOCKER_PACKAGES[@]}"
    # call order matters (not alphabetical): plugins dir before the VM
    _setup_docker_cli
    _setup_colima
fi

_setup_zsh_plugins

_draw_spacer

# call order matters (not alphabetical): zsh file, then tools, then rust extras on top of mise rust
_setup_mise
_setup_mise_tools
_setup_rust

_draw_spacer

(( ${#MISE_FAILED_TOOLS[@]} == 0 )) || { echo "mise failed for: ${MISE_FAILED_TOOLS[*]}"; exit 1; }

