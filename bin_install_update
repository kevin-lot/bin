#!/usr/bin/env bash
# install or update my machines: professional macbook (darwin), personal computer (fedora)

#set -o xtrace -o errexit
set -o errexit

ZSH_PLUGINS_PATH="${HOME}/.zsh_plugins"
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
if [[ "${OS}" == "linux" ]]; then
    # distro id, e.g. "fedora"
    OS=$(. /etc/os-release && echo "${ID}")
fi

_draw_spacer() { echo "+++++++++ +++++++++ +++++++++ +++++++++"; echo; echo; }
_draw_title() { echo "+++++++++ ${1} +++++++++"; echo; echo; }
_show_message_mise() {
    cat <<"EOF"
    command -v mise &>/dev/null && {
        # keep this activation order
        eval "$(mise activate zsh --shims)"
        eval "$(mise activate zsh)"

        eval "$(mise hook-env -s zsh)"
        rehash
        LOADED+=("mise")
    }
EOF
}
_show_message_mise_tools() {
    cat <<"EOF"
    rustup component list --installed
    cargo install --list

    rustup component add rust-analyzer
    cargo install cargo-cache
    cargo install cargo-lambda
    cargo install cargo-watch

    [[ -f "${BIN_PATH}/bin/terraform-docs" ]] && eval "$(terraform-docs completion zsh)"
    [[ -f "${BIN_PATH}/bin/terragrunt" ]] && complete -o nospace -C "${BIN_PATH}/bin/terragrunt" terragrunt
EOF
}
_show_message_colima() {
    cat <<"EOF"
    # once: in ~/.docker/config.json, so docker finds the brew compose/buildx plugins
    "cliPluginsExtraDirs": ["/opt/homebrew/lib/docker/cli-plugins"]
EOF
}
_install_zsh_plugins() {
    _draw_title "zsh plugins install"
    type -p git 1>/dev/null || { echo "git is required"; exit 1; }

    [[ -d "${ZSH_PLUGINS_PATH}" ]] || install -d -m 700 "${ZSH_PLUGINS_PATH}"

    local zsh_plugins=(
        https://github.com/zsh-users/zsh-autosuggestions.git
        https://github.com/zsh-users/zsh-syntax-highlighting.git
        https://github.com/zsh-users/zsh-history-substring-search.git
    )
    local url install_path
    for url in "${zsh_plugins[@]}"; do
        install_path="${ZSH_PLUGINS_PATH}/$(basename "${url}" .git)"
        if [[ -d "${install_path}/.git" ]]; then
            git -C "${install_path}" pull --quiet --ff-only
            continue
        fi
        rm -rf "${install_path}"
        git clone --quiet "${url}" "${install_path}"
    done
}
_install_mise_tools() {
    _draw_title "mise tools install"
    type -p mise 1>/dev/null || { echo "mise is required"; exit 1; }

    local mise_tools=(
        act
        actionlint
        aws-cli
        bat
        circleci
        claude
        dagger
        flutter
        gh
        jmespath
        jq
        lazygit
        mole
        node
        poetry
        rust
        terraform
        terraform-docs
        terragrunt
        tflint
        uv
        yamllint
        yq
    )
    # one call per tool: a failing tool must not block the others
    local tool
    local failed=()
    for tool in "${mise_tools[@]}"; do
        mise use --global "${tool}@latest" || failed+=("${tool}")
    done

    _show_message_mise_tools
    if (( ${#failed[@]} > 0 )); then
        echo "mise failed for: ${failed[*]}"
        return 1
    fi
}

# shared by fedora and darwin
COMMON_PACKAGES=(
    btop
    git
    git-delta
    micro
    mise
    ncdu
    nmap
    starship
    xmlstarlet
    )

if [[ "${OS}" == "fedora" ]]; then
    _draw_title "install dnf packages"
    sudo dnf copr --assumeyes enable jdxcode/mise
    sudo dnf copr --assumeyes enable atim/starship
    sudo dnf update --assumeyes

    FEDORA_PACKAGES=(
        automake
        dconf-editor
        gcc
        gcc-c++
        gparted
        kernel-devel
        make
        rpi-imager
        terminator
        traceroute
        #ngrok
    )
    sudo dnf install --assumeyes "${FEDORA_PACKAGES[@]}" "${COMMON_PACKAGES[@]}"
    _show_message_mise
fi

if [[ "${OS}" == "darwin" ]]; then
    _draw_title "install brew packages"
    type -p brew 1>/dev/null || { echo "brew is required"; exit 1; }
    brew update && brew upgrade

    CASK_PACKAGES=(
        ghostty
        wizcli
    )
    brew install --cask "${CASK_PACKAGES[@]}"

    COMMON_PACKAGES=(
        btop
        git
        git-delta
        micro
        mise
        ncdu
        nmap
        scrcpy
        starship
        xmlstarlet
    )
    brew install "${COMMON_PACKAGES[@]}"
    #    brew install                                                                                  \
    #         colima                        docker                         docker-compose              \
    #         docker-credential-helper
    _show_message_mise
fi

_install_zsh_plugins

_draw_spacer

type -p mise 1>/dev/null || { echo "mise is required"; exit 1; }
mise use --global act@latest
mise use --global actionlint@latest
mise use --global aws-cli@latest
mise use --global bat@latest
mise use --global circleci@latest
mise use --global claude@latest
mise use --global dagger@latest
mise use --global flutter@latest
mise use --global gh@latest
mise use --global jq@latest
mise use --global jmespath@latest
mise use --global jq@latest
mise use --global lazygit@latest
mise use --gloabl mole@latest
mise use --global node@latest
mise use --global poetry@latest
mise use --global rust@latest && {
    cat <<"EOF"
    rustup component list --installed
    cargo install --list

    rustup component add rust-analyzer
    cargo install cargo-cache
    cargo install cargo-lambda
    cargo install cargo-watch
EOF
}
mise use --global terraform@latest
mise use --global terraform-docs@latest && {
    cat <<"EOF"
    [[ -f "${BIN_PATH}/bin/terraform-docs" ]] && eval "$(terraform-docs completion zsh)"
EOF
}
mise use --global terragrunt@latest && {
    cat <<"EOF"
    [[ -f "${BIN_PATH}/bin/terragrunt" ]] && complete -o nospace -C "${BIN_PATH}/bin/terragrunt" terragrunt
EOF
}
mise use --global tflint@latest
mise use --global uv@latest
mise use --global yamllint@latest
mise use --global yq@latest

_draw_spacer

